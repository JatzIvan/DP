<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    
    <!-- <add key="DataServerHost" value="localhost"/> -->
    <!-- <add key="DATASERVER_HOST" value="integration_module"/> -->
    <add key="DATASERVER_HOST" value="localhost"/>
    <add key="DATASERVER_PORT" value="1998"/>
    
    <!-- <add key="DigiMap" value="http://10.10.1.127:8000/"/> -->
    <!-- <add key="DigiMap" value="http://192.168.31.12:8000/"/> -->
    <!--<add key="DigiMap" value="http://192.168.43.43:8000/"/> -->
    <!-- <add key="DigiMap" value="http://192.168.12.17:8000/"/> -->
    
    <add key="DIGIMAP_HOST" value="localhost"/>
    <add key="DIGIMAP_PORT" value="8000"/>
    
    <!-- <add key="DIGIMAP_URL" value="http://127.0.0.1:8000/"/> -->
    
    <add key = "CURVETURE_CALC_METHOD" value="CircumcircleRoadCircleCurvesResolver"/>
    <add key = "SIMPLIFICATION_METHOD" value="DouglasPeuckerRoadSectionSimplification"/>
    <add key="RoadQueryLong1" value= "17.150139"/>
    <add key="RoadQueryLat1" value= "48.370298"/>
    <add key="RoadQueryLong2" value= "17.265176"/>
    <add key="RoadQueryLat2" value= "48.306885"/>
    <!-- <add key="RoadQueryRef" value= "503"/> -->
    <add key="CustomRoadParameters" value= "ref=503"/>
    <add key="LINE_SIMPLIFICATION_TOLERANCE" value="0.3"/>
    <add key="CURVATURE_TRESHOLD" value="0.006"/>
    <add key="CAR_DISTANCE_SKIP_TRESHOLD" value="300"/>
    <add key="CURVE_COLLISION_CALCULATOR" value="SimpleCurveRoadCurvatureCalculator"/>
    <add key="STRAIGHT_COLLISION_CALCULATOR" value="SimpleTTCCalculator"/>
    <add key="MAX_SPEED_CALC_METHOD" value="SimpleMaxSpeedCalcBasedOnFriction"/>
    <add key="MAX_PARALLELISM" value="4"/>
    <add key="KEEP_ALIVE_FREQUENCY" value="6000"/>

    <add key="RoadGroupByAttribute" value="Ref"/>
    
    <add key="ROAD_STATE_FETCHER" value="OpenWeatherMapFetcher"/>

    <add key="OPEN_WEATHER_API_KEY" value="657ef95616b9b0221d708b6f12d860a1"/>

    <add key="MAP_DATA_ORIGIN" value="remote"/>
    <!-- <add key="LOCAL_DATA_PATH" value="Roads.json"/> -->
    
  </appSettings>
</configuration>