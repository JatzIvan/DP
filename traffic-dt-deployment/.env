# =============== README ========================
# Host ports - ports published on the host computer
# Container ports - ports used internally inside docker bridge network


# ---------- Integration Module ------------------

# Integration module ports for processor apps connections (collision detection apps, etc.)
INTEGRATION_MODULE_PROCESSORS_HOST_PORT = 1998
INTEGRATION_MODULE_PROCESSORS_CONTAINER_PORT = 1998

# Integration module ports for vehicle connections
INTEGRATION_MODULE_VEHICLES_HOST_PORT = 1999
INTEGRATION_MODULE_VEHICLES_CONTAINER_PORT = 1999

# Geographical area managed by this Integration module (Digital Twin)
INTEGRATION_MODULE_AREA_TOP_LEFT_LAT = 48.363041
INTEGRATION_MODULE_AREA_TOP_LEFT_LON = 17.163231
INTEGRATION_MODULE_AREA_BOTTOM_RIGHT_LAT = 48.347385
INTEGRATION_MODULE_AREA_BOTTOM_RIGHT_LON = 17.220217

# After how much seconds of no datagram received from a vehicle is it disconnected
INTEGRATION_MODULE_VEHICLE_KEEPALIVE_TIMEOUT = 3

# After how much seconds of no datagram received from a processor module is it disconnected
INTEGRATION_MODULE_PROCESSOR_KEEPALIVE_TIMEOUT = 30

# How long are notifications from Processor Modules stored and reported to subscribers in seconds
INTEGRATION_MODULE_NOTIFICATIONS_DURATION = 2

# If you want to log all the messages that were received from vehicles, provide here path to the output log file, if none, then loggin is off
INTEGRATION_MODULE_VEHICLES_LOG_FILEPATH = "" # e.g."/volume/VehicleLogs/bratislava.log"


# ---------- Visualization Processor ------------------

# Visualization processor provides REST/Websocket backend for visualization apps (React map, etc.)
VISUALIZATION_PROCESSOR_HOST_PORT = 8888 # This value should not be changed as it is used in traffic-dt-dashboard connection
VISUALIZATION_PROCESSOR_CONTAINER_PORT = 8888

# Interval of sending keep-alive messages to Integration Module in seconds
VISUALIZATION_PROCESSOR_KEEPALIVE_INTERVAL = 20

# Interval in which the Integration Module will send updates about vehicles in seconds
VISUALIZATION_PROCESSOR_SUBSCRIPTION_INTERVAL = 0.1

# Interval of checking whether the subscription to Integration Module is active in seconds
VISUALIZATION_PROCESSOR_SUBSCRIPTION_CHECK_INTERVAL = 10


# ---------- Dashboard --------------------------------

# Dashboard web application ports accesible via browser
DASHBOARD_HOST_PORT = 3456
DASHBOARD_CONTAINER_PORT= 3456
DASHBOARD_API_REST_BASE_URL = http://localhost:8888
DASHBOARD_API_WEBSOCKET_BASE_URL = ws://localhost:8888


# ---------- Vehicle Simulator --------------------------------

# Docker container --restart parameter (possible values: always, unless-stopped, no, on-failure[:max-retries])
VEHICLE_SIMULATOR_RESTART = unless-stopped

# Dump used by the Vehicle Simulator to load and send vehicle data
# Note: The Volumes/VehicleSimulator folder is bound to the /volume directory of VehicleSimulator container
VEHICLE_SIMULATOR_DUMP_FILEPATH = "/volume/Dumps/sumoTrace_100ms.xml"

# How many seconds from start of the dump to skip (50 means the dump starts to be read at timestamp 50 s)
VEHICLE_SIMULATOR_VEHICLE_DUMP_START_TIME_OFFSET = 0


# ---------- Processor Simulator ------------------

# Interval of sending keep-alive messages to Integration Module in seconds
PROCESSOR_SIMULATOR_KEEPALIVE_INTERVAL = 20

# Interval in which the Integration Module will send updates about vehicles in seconds
PROCESSOR_SIMULATOR_SUBSCRIPTION_INTERVAL = 0.1

# Interval of checking whether the subscription to Integration Module is active in seconds
PROCESSOR_SIMULATOR_SUBSCRIPTION_CHECK_INTERVAL = 10

# ------------------ HEAD COLLISION MODULE PARAMS ---------------------
DIGIMAP_HOST = host.docker.internal
DIGIMAP_PORT = 8000
HEAD_COLLISION_DIGIMAP_URL = "http://ail-lab.fiit.stuba.sk:8000"

# Simplification tolerance in meters (0 means all road points will be used)
HEAD_COLLISIONS_LINE_SIMPLIFICATION_TOLERANCE = 0.3

# 1/(degree of curvature). Treshold from which part of road is considered as curve. The higher the number means sharper curvature is required to be classified as curve
HEAD_COLLISIONS_CURVATURE_TRESHOLD = 0.006

# Max distance between cars (in meters) allowed for calculations 
HEAD_COLLISIONS_CAR_DISTANCE_SKIP_TRESHOLD = 300

# Current Road section fetcher (Open weather map has a limited number of free requests per day. For testing purposes use DummyRoadStateFetcher)
HEAD_COLLISIONS_ROAD_STATE_FETCHER = "OpenWeatherMapFetcher"

# OpenWeatherMap requires API key to work
HEAD_COLLISIONS_OPEN_WEATHER_API_KEY = "657ef95616b9b0221d708b6f12d860a1"

# Degree of parallelism (-1 is unlimited)
HEAD_COLLISIONS_MAX_PARALLELISM = -1

# Interval in which Integration module will send information about current road state (vehicles). Value in seconds
HEAD_COLLISIONS_INTEGRATION_MODULE_INTERVAL = 0.2

# Approach for road data acquisition. Possible values: "local", "remote".
# "local" - reads data from json (needs to comply with DIGIMAP structure). HEAD_COLLISIONS_LOCAL_DATA_PATH needs to be provided with the dump
# "remote" - reads data from DIGIMAP. DIGIMAP_URL or DIGIMAP_HOST:DIGIMAP_PORT needs to be provided
HEAD_COLLISION_MAP_DATA_ORIGIN = "local"

# Path to the road data dump
HEAD_COLLISIONS_LOCAL_DATA_PATH = "/volume/Roads.json"